[Unit]
Description=anda_brain service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/app
EnvironmentFile=-/home/ec2-user/app/.env
ExecStart=/home/ec2-user/app/anda_brain aws

Restart=on-failure
RestartSec=5

LimitNOFILE=65536

StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# /home stays visible (binary and data live there) but read-only;
# ReadWritePaths then re-enables writes for the data directory only.
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/app
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallFilter=@system-service
# Listens on an unprivileged port (8042); no capabilities required.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
